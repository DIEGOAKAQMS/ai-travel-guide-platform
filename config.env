# =====================================================================
#  旅行攻略平台 · 统一配置文件
# =====================================================================
#
#  【这个文件是干什么的】
#  本项目所有「需要额外付费 / 需要申请 key」的配置都集中在这里，
#  后端服务（server）和前端页面（web）都读这一份，不用再去翻两个 .env。
#
#  【改完怎么生效】
#    · 后端：重启 server 目录下的 `npm run dev`
#    · 前端：重启项目根目录下的 `npm run dev`
#      —— 前端这几项是在启动/构建时注入到代码里的，热更新不会重读本文件
#
#  【优先级】同一项在多处出现时，取第一个「非空」的值：
#    1. 真实环境变量（docker / CI 注入的）
#    2. 本文件 config.env          ← 你平时只需要改这里
#    3. 根目录 .env（历史遗留，前端用，不进 git）
#    4. server/.env（历史遗留，后端用，不进 git）
#    5. 代码里的默认值
#  所以：某一项在本文件里留空 = 自动让下面那些旧文件兜底，不会因此报错。
#  下面凡是没有特殊说明的项，留空都等于「用默认值」。
#
#  【⚠️ 本文件已纳入 git】
#  里面请保持空值 / 占位符。要填真实密钥，二选一：
#    · 就填在这里 —— 提交前务必检查，别把密钥推到远端
#    · 填在根 .env 或 server/.env —— 这两个文件已在 .gitignore 里，不会进版本库
#
#  【计费速览】★ 越多越费钱
#    ★★★  DeepSeek API  —— 按 token 计费，本平台最大成本项
#    ★★    高德地图 key  —— 地理编码 / 路径规划按调用量计费
#    ★     天地图 token  —— 免费额度较大；商用需单独授权
#    ★     Cesium ion    —— 三维地形，免费额度有限，超出按量计费
#    （具体额度与单价以各家控制台为准，这里不写死数字以免误导）
#
# =====================================================================


# ---------------------------------------------------------------------
#  一、DeepSeek —— 生成行程用的模型（★★★ 按 token 计费）
#      申请地址：https://platform.deepseek.com/api_keys
# ---------------------------------------------------------------------

# ★★★ 接口密钥。留空则「AI 生成攻略」完全不可用。
DEEPSEEK_API_KEY=

# 接口地址。换成兼容 OpenAI 协议的第三方网关时改这里。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名。不同型号单价不同。
DEEPSEEK_MODEL=deepseek-flash

# ★★ 单次调用的输出预算（tokens）。
#    关键点：模型把「思考 reasoning」和「JSON 正文」算进同一份额度，
#    所以这个值是「思考 + 正文」的总量，不是正文的量。
#    实测：一次 10 天攻略 = 思考 29k + 正文 18.7k ≈ 47.8k tokens。
#    给 32768 时首轮必然写满被截断丢弃、再翻倍重试才成功（白跑约 3 分钟），
#    所以起步值必须 ≥ 65536。调低能省钱，但小值大概率重试，反而更贵。
DEEPSEEK_MAX_TOKENS=65536

# ★★ 思考强度：off / low / high
#    思考 token 约占输出的 84%，这一项对成本影响最大。
#      high  排程质量最好（默认），也最贵
#      low   明显提速、明显便宜，复杂线路会略粗糙
#      off   最快最便宜，质量下降较明显
DEEPSEEK_REASONING_EFFORT=high

# ★ 「澄清提问」那一步的思考强度（正式排行程前的反问）。
#    只需要产出几个问题，用不着深度推理，默认关掉最省。
DEEPSEEK_CLARIFY_REASONING_EFFORT=off

# 透传给网关的额外请求参数（JSON 字符串；留空则不追加任何字段）。
# 例：{"enable_thinking":false}
DEEPSEEK_EXTRA_BODY=

# 超时（毫秒）。不直接产生费用，但设置不当会让已经花钱跑起来的调用白费：
#   IDLE  多久收不到任何数据就判定卡死
#   TOTAL 一次请求的硬上限。要按最大 token 预算给足 —— 65536 预算按实测
#         吞吐（约 180 tokens/s）需要约 6 分钟，卡太紧会把本可成功的调用砍掉。
DEEPSEEK_IDLE_MS=60000
DEEPSEEK_TOTAL_MS=600000


# ---------------------------------------------------------------------
#  二、高德地图 Web 服务 —— 地理编码 / 路径规划（★★ 按调用量计费）
#      申请地址：https://console.amap.com/dev/key/app
#      key 类型必须选「Web 服务」，不是「Web端(JS API)」。
# ---------------------------------------------------------------------

# ★★ 密钥。留空则：节点解析不出坐标（地图上没有点）、行车路线也画不出来。
AMAP_KEY=

# 两次高德请求之间的最小间隔（毫秒）。
# 高德对并发 QPS 有硬限制，实测并发会报 10021 CUQPS_HAS_EXCEEDED_THE_LIMIT，
# 所以这里强制串行 + 限速。调小会更快，但更容易撞限流。
AMAP_MIN_INTERVAL_MS=350


# ---------------------------------------------------------------------
#  三、天地图 —— 底图瓦片 + 地理编码兜底（★ 免费额度较大，商用需授权）
#      申请地址：https://console.tianditu.gov.cn/api/key
# ---------------------------------------------------------------------

# ★ 后端用：高德地理编码全部失败时，用天地图再兜一次。
TIANDITU_TOKEN=

# ★ 前端用。必须有 VITE_ 前缀，Vite 才会把它注入到浏览器端代码里。
#    这是地图底图瓦片：用户每浏览一次地图都在消耗配额。
#    注意：天地图 token 通常绑定域名白名单，本地开发要把
#    localhost / 127.0.0.1 加进控制台白名单，否则底图加载不出来
#    （页面上会弹出「未检测到天地图 token」的提示条）。
VITE_TIANDITU_TOKEN=


# ---------------------------------------------------------------------
#  四、Cesium ion —— 三维高程地形（★ 免费额度有限，超出计费）
#      申请地址：https://ion.cesium.com/tokens
# ---------------------------------------------------------------------

# ★ 前端用。留空会自动降级，不影响其它功能。
VITE_CESIUM_ION_TOKEN=

# 是否启用真实高程地形。置 false 回退为光滑椭球面（最省）。
VITE_TERRAIN_ENABLED=true

# 地形数据源优先级：
#   1) 配了 VITE_TERRAIN_URL       -> 自建地形服务（服务器成本自理）
#   2) 配了 VITE_CESIUM_ION_TOKEN  -> Cesium ion World Terrain（★ 计费）
#   3) 都不配                      -> 免 token 的公共 ArcGIS World Elevation 3D
VITE_TERRAIN_URL=

# 自建地形服务类型：cesium = quantized-mesh，arcgis = ArcGIS ImageServer
VITE_TERRAIN_TYPE=cesium


# ---------------------------------------------------------------------
#  五、数据库（PostgreSQL + PostGIS）
#      不算 token，但云数据库同样按量计费，所以一并列在这里。
#      留空即回退到 server/.env 或代码默认值
#      （127.0.0.1:5432 / 用户 postgres / 库 travel_guide）。
# ---------------------------------------------------------------------

PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=


# ---------------------------------------------------------------------
#  六、其它（与费用无关）
# ---------------------------------------------------------------------

# 后端监听端口，留空默认 5300
PORT=

# development / production，留空默认 development
NODE_ENV=
