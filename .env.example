# =====================================================================
#  本文件是「历史遗留配置」模板：复制成根目录 .env 后仍可用，
#  优先级低于仓库根目录的 config.env。
#  日常改配置请直接改 config.env —— 那里有全部付费项的说明。
# =====================================================================

# ===== 天地图服务配置 =====
# 天地图开发者 token（必填）。申请地址：https://console.tianditu.gov.cn/api/key
VITE_TIANDITU_TOKEN=

# ===== 真实高程地形 =====
# 是否启用三维高程地形。置为 false 则回退为光滑椭球面。
VITE_TERRAIN_ENABLED=true

# 自定义地形服务地址（可选，配置后优先使用）
VITE_TERRAIN_URL=
# 自定义地形服务类型：cesium = quantized-mesh，arcgis = ArcGIS ImageServer
VITE_TERRAIN_TYPE=cesium

# Cesium Ion token（可选）。申请地址：https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=
