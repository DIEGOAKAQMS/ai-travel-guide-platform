# =====================================================================
#  本文件是「历史遗留配置」模板：复制成 server/.env 后仍可用，
#  优先级低于仓库根目录的 config.env。
#  日常改配置请直接改根目录的 config.env —— 那里有全部付费项的说明。
# =====================================================================

# ===== 服务 =====
PORT=5300
NODE_ENV=development

# ===== PostgreSQL =====
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=travel_guide

# ===== DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=65536
# NOTE: reasoning tokens share this budget with the JSON body; if the budget is
#       too small the model burns it all on reasoning and the JSON body comes back
#       empty or truncated.
#       A 7-day guide needs ~11.5k tokens of JSON plus up to 24k of reasoning;
#       a 10-day guide实测 needs ~29k reasoning + ~19k JSON = ~48k in ONE pass.
#       At 32768 the first attempt is therefore guaranteed to be truncated and
#       thrown away, and the retry doubles the budget —实测把 8 分钟的生成里
#       白扔了 3 分钟。所以起步值必须 ≥ 65536，Do NOT lower it.
# reasoning effort: low / high / off (code default high)
DEEPSEEK_REASONING_EFFORT=high
# clarify step effort (code default off = fastest)
DEEPSEEK_CLARIFY_REASONING_EFFORT=off

# ===== 高德 Web 服务 =====
AMAP_KEY=

# ===== 天地图（兜底地理编码）=====
TIANDITU_TOKEN=
